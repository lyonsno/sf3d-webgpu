{
  "name": "sf3d-webgpu",
  "version": "0.0.1",
  "private": true,
  "description": "Stable Fast 3D (SF3D) single-image 3D mesh generation in WebGPU compute shaders",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:kit-route-contract": "node tools/test_kit_route_contract.mjs",
    "test:cooperative-dino": "node --import ./tools/wgsl-raw-loader-register.mjs tools/test_cooperative_dino_contract.mjs",
    "test:cooperative-dino-conformance": "node --import ./tools/wgsl-raw-loader-register.mjs tools/test_cooperative_dino_conformance.mjs",
    "test:cooperative-post-processor": "node --import ./tools/wgsl-raw-loader-register.mjs tools/test_cooperative_post_processor_contract.mjs",
    "test:cooperative-post-processor-layers": "node --import ./tools/wgsl-raw-loader-register.mjs tools/test_cooperative_post_processor_layer_contract.mjs",
    "test:cooperative-post-processor-channels": "node --import ./tools/wgsl-raw-loader-register.mjs tools/test_cooperative_post_processor_channel_contract.mjs",
    "test:cooperative-two-stream": "node --import ./tools/wgsl-raw-loader-register.mjs tools/test_cooperative_two_stream_contract.mjs",
    "test:two-stream-linear-ranges": "node --import ./tools/wgsl-raw-loader-register.mjs tools/test_two_stream_linear_ranges.mjs && node tools/test_two_stream_smoke_acceptance.mjs",
    "test:worker-lifecycle": "node tools/test_worker_call_lifecycle.mjs",
    "test:cooperative-texture-telemetry": "node tools/test_cooperative_texture_bake_telemetry.mjs && node tools/test_cooperative_texture_bake_failures.mjs && node tools/test_cooperative_texture_bake_source_identity.mjs",
    "test:decoder-arena": "node tools/test_decoder_scratch_arena.mjs",
    "test:tet-asset-origin": "node tools/test_tet_asset_origin.mjs",
    "test:clip-shader-origin": "node tools/test_clip_shader_origin.mjs",
    "smoke:arena-ab": "node tools/smoke_arena_ab.mjs",
    "smoke:cooperative-post-processor": "node tools/smoke_cooperative_post_processor_ab.mjs",
    "test:materialize-core": "node tools/test_materialize_core.mjs",
    "smoke:five-arm": "node tools/smoke_five_arm_ab.mjs",
    "test:full-route-benchmark": "node tools/test_full_route_benchmark_contract.mjs",
    "smoke:full-route-pair": "node tools/smoke_five_arm_ab.mjs --profile paired",
    "test:postprocessor-bounded-prefix": "node --import ./tools/wgsl-raw-loader-register.mjs tools/test_postprocessor_bounded_prefix_contract.mjs",
    "test:bounded-prefix-acceptance": "node tools/test_bounded_prefix_acceptance_contract.mjs",
    "test:partial-arm-failure": "node tools/test_partial_arm_failure_contract.mjs",
    "test:parent-phase-journal": "node tools/test_parent_phase_journal_contract.mjs",
    "test:m2-staged-discriminant": "node tools/test_m2_staged_discriminant_contract.mjs && node tools/test_m2_pressure_observer_contract.mjs",
    "smoke:m2-staged": "node tools/smoke_m2_staged_discriminant.mjs",
    "replay:m2-journal": "node tools/replay_parent_phase_journal.mjs"
  },
  "devDependencies": {
    "@kaminos/webgpu-inference-kit": "0.1.42",
    "puppeteer-core": "^25.2.1",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "xatlas-web": "^0.1.0"
  }
}
