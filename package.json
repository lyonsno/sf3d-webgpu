{
  "name": "sf3d-webgpu",
  "version": "0.0.1",
  "private": true,
  "description": "Stable Fast 3D (SF3D) single-image 3D mesh generation in WebGPU compute shaders",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test:build-weight-exclusion": "node tools/test_build_weight_exclusion.mjs && node tools/test_build_without_public_dir.mjs",
    "test:kit-route-contract": "node tools/test_kit_route_contract.mjs",
    "test:cooperative-dino": "node --import ./tools/wgsl-raw-loader-register.mjs tools/test_cooperative_dino_contract.mjs",
    "test:cooperative-dino-conformance": "node --import ./tools/wgsl-raw-loader-register.mjs tools/test_cooperative_dino_conformance.mjs",
    "test:worker-lifecycle": "node tools/test_worker_call_lifecycle.mjs",
    "test:cooperative-texture-telemetry": "node tools/test_cooperative_texture_bake_telemetry.mjs && node tools/test_cooperative_texture_bake_failures.mjs && node tools/test_cooperative_texture_bake_source_identity.mjs",
    "test:decoder-arena": "node tools/test_decoder_scratch_arena.mjs",
    "test:tet-asset-origin": "node tools/test_tet_asset_origin.mjs",
    "smoke:arena-ab": "node tools/smoke_arena_ab.mjs",
    "test:materialize-core": "node tools/test_materialize_core.mjs",
    "smoke:five-arm": "node tools/smoke_five_arm_ab.mjs"
  },
  "devDependencies": {
    "@kaminos/webgpu-inference-kit": "0.1.38",
    "puppeteer-core": "^25.2.1",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "xatlas-web": "^0.1.0"
  }
}
