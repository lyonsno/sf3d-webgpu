# Hosted build configuration (auto-loaded by `vite build`).
# The static site never serves the ~2.1 GB model itself; the browser streams it
# from the HuggingFace CDN mirror instead.
VITE_WEIGHTS_URL=https://huggingface.co/BasinShapers/sf3d-webgpu-weights/resolve/main/weights.bin

# GitHub Pages project site serves from /sf3d-webgpu/.
VITE_BASE=/sf3d-webgpu/
